        1d-9 1.0 1.0
'sylvite' 1 0 0.0 1.0 'Inskeep and Bloom, 1986'
        1d0 1.0 1.0
'halite' 1 0 0.0 1.0 'Inskeep and Bloom, 1986'
        1d-9 1.0 1.0
'calcite3' 1 0 0.0 1.0 'Inskeep and Bloom, 1986'
        1d0 1.0 1.0
'calcite1' 1 1 1.44d4 1.0 'Chou et al., 1989'
       3.33248d2 1.0 3.0
